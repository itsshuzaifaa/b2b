# ==============================================================================
# B2B LINK - Clean Environment Variables (No NEXT_PUBLIC_ required)
# ==============================================================================
# Both clean names (SUPABASE_URL) and legacy names (NEXT_PUBLIC_SUPABASE_URL)
# are supported automatically across client and server.
# ==============================================================================

# Supabase Credentials (from Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend Email Configuration (from Resend Dashboard -> API Keys)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="B2B LINK <notifications@yourdomain.com>"

# App URL
APP_URL=http://localhost:3000
